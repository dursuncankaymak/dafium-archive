<Window x:Class="DafiumArsiv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource s.app}" Width="1120" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Zemin}" Foreground="{StaticResource Yazi}"
        FontFamily="{StaticResource Yazitipi}" FontSize="13.5"
        AllowDrop="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="uygulama.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Kok">
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="820" Height="560" Canvas.Left="260" Canvas.Top="-360" Opacity="0.55">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#666C4DFF" Offset="0" />
            <GradientStop Color="#006C4DFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="Isik2" Width="620" Height="460" Canvas.Left="700" Canvas.Top="-220" Opacity="0.4">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#55FF4FD8" Offset="0" />
            <GradientStop Color="#00FF4FD8" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Width="28" Height="28" CornerRadius="9" ClipToBounds="True" Background="Black">
            <Image Source="gorseller/dafi.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.RenderTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25" CenterX="14" CenterY="14" /></Image.RenderTransform>
            </Image>
          </Border>
          <TextBlock Text="{DynamicResource s.app}" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource Parlak}" Margin="10,0,0,0" VerticalAlignment="Center" />
          <Border x:Name="ArsivCipi" Visibility="Collapsed" Margin="14,0,0,0" Padding="10,4" CornerRadius="8" Background="#1FFFFFFF">
            <TextBlock x:Name="ArsivAdi" Foreground="{StaticResource Vurgu2}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MenuDugme" Content="&#xE712;" Click="Menu_Click" Style="{StaticResource PencereDugme}" FontSize="14" ToolTip="{DynamicResource s.menu}">
            <Button.ContextMenu>
              <ContextMenu x:Name="UcNokta" Placement="Bottom">
                <MenuItem Header="{DynamicResource s.new_archive}" Tag="&#xE710;" Click="YeniArsiv_Click" />
                <MenuItem x:Name="KabukMenu" Header="" Tag="&#xE8DE;" Click="Kabuk_Click" />
                <MenuItem Header="{DynamicResource s.about}" Tag="&#xE946;" Click="Hakkinda_Click" />
                <MenuItem Header="{DynamicResource s.other_lang}" Tag="&#xE774;" Click="Dil_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="KucukDugme" Content="&#xE921;" Click="Kucult_Click" Style="{StaticResource PencereDugme}" ToolTip="{DynamicResource s.minimize}" />
          <Button x:Name="BuyukDugme" Content="&#xE922;" Click="Buyut_Click" Style="{StaticResource PencereDugme}" ToolTip="{DynamicResource s.maximize}" />
          <Button Content="&#xE8BB;" Click="Kapat_Click" Style="{StaticResource KapatDugme}" ToolTip="{DynamicResource s.close}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="AracCubugu" Grid.Row="1" Margin="16,4,16,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource AnaDugme}" Click="Cikar_Click" x:Name="CikarDugme">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,8,0" />
              <TextBlock x:Name="CikarYazi" Text="{DynamicResource s.extract}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Dugme}" Click="Buraya_Click" Margin="8,0,0,0" ToolTip="{DynamicResource s.extract_here_tip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,8,0" />
              <TextBlock Text="{DynamicResource s.extract_here}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Dugme}" Click="Ac_Click" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,8,0" />
              <TextBlock Text="{DynamicResource s.open_other}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border HorizontalAlignment="Right" Width="260" Height="38" CornerRadius="11" Background="#14FFFFFF" BorderBrush="{StaticResource Cizgi}" BorderThickness="1">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Simge}" Foreground="{StaticResource Soluk}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="Arama" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Parlak}" CaretBrush="{StaticResource Vurgu2}"
                     VerticalAlignment="Center" Margin="36,0,10,0" FontSize="13.5" TextChanged="Arama_TextChanged" />
            <TextBlock Text="{DynamicResource s.search}" Foreground="{StaticResource Soluk}" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False" x:Name="AramaIpucu" />
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="KonumCubugu" Grid.Row="2" Margin="16,0,16,8" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource SimgeDugme}" Content="&#xE74A;" Height="30" Width="30" Click="Yukari_Click" x:Name="YukariDugme" ToolTip="{DynamicResource s.up}" />
          <ItemsControl x:Name="Konum" Margin="8,0,0,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Simge}" FontSize="10" Foreground="{StaticResource Soluk}" VerticalAlignment="Center" Margin="6,1,6,0" Visibility="{Binding AyracGorunum}" />
                  <Button Content="{Binding Ad}" Tag="{Binding Yol}" Click="Konum_Click" Cursor="Hand" Foreground="{StaticResource Yazi}" FontWeight="SemiBold">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="K" Background="Transparent" CornerRadius="7" Padding="8,4"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="#1FFFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid x:Name="Icerik" Grid.Row="3" Margin="16,0,16,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="16" Background="#B315122A" BorderBrush="{StaticResource Cizgi}" BorderThickness="1" Padding="0,2,0,6">
          <ListView x:Name="Liste" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Yazi}"
                    ItemContainerStyle="{StaticResource Satir}" SelectionMode="Extended"
                    MouseDoubleClick="Liste_MouseDoubleClick" PreviewMouseLeftButtonDown="Liste_FareBas" PreviewMouseMove="Liste_FareKay" SelectionChanged="Liste_SelectionChanged" KeyDown="Liste_KeyDown"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    GridViewColumnHeader.Click="Baslik_Click">
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource SutunBasligi}">
                <GridViewColumn x:Name="SutunAd" Width="350">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{Binding SimgeZemin}">
                          <TextBlock Text="{Binding Simge}" FontFamily="{StaticResource Simge}" FontSize="14" Foreground="{Binding SimgeRenk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Ad}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="{Binding Kalinlik}" />
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Simge}" FontSize="11" Foreground="#FFD166" Margin="8,1,0,0" VerticalAlignment="Center" Visibility="{Binding SifreGorunum}" ToolTip="{DynamicResource s.encrypted}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="SutunBoyut" Width="100">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BoyutYazi}" Foreground="{StaticResource Soluk}" /></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="SutunPaketli" Width="100">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PaketliYazi}" Foreground="{StaticResource Soluk}" /></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="SutunTur" Width="110">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Tur}" Foreground="{StaticResource Soluk}" /></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="SutunTarih" Width="160">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TarihYazi}" Foreground="{StaticResource Soluk}" /></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </Border>

        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="16" Background="#B315122A" BorderBrush="{StaticResource Cizgi}" BorderThickness="1" Padding="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="OnizlemeKutu" CornerRadius="12" Background="#0E0C1C" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="OnizlemeSimge" FontFamily="{StaticResource Simge}" FontSize="64" Foreground="{StaticResource Vurgu2}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE7B8;" Opacity="0.85" />
                <Image x:Name="OnizlemeResim" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Margin="6" />
                <TextBox x:Name="OnizlemeYazi" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Yazi}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
                <TextBlock x:Name="OnizlemeDurum" Foreground="{StaticResource Soluk}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" FontSize="12" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
              <TextBlock x:Name="OnizlemeAd" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Parlak}" TextWrapping="Wrap" />
              <TextBlock x:Name="OnizlemeBilgi" Foreground="{StaticResource Soluk}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" />
              <Button x:Name="DosyaAcDugme" Style="{StaticResource Dugme}" Click="DosyaAc_Click" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,8,0" />
                  <TextBlock Text="{DynamicResource s.open_file}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4" Margin="20,0,20,0">
        <TextBlock x:Name="Durum" Foreground="{StaticResource Soluk}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock x:Name="MotorYazi" Foreground="#6F6A94" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid x:Name="BosEkran" Grid.Row="1" Grid.RowSpan="3">
        <Border x:Name="BirakmaAlani" Margin="40,10,40,24" CornerRadius="28" BorderThickness="2" Background="#6615122A">
          <Border.BorderBrush>
            <VisualBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
              <VisualBrush.Visual>
                <Rectangle Width="14" Height="14" Fill="#4D6C4DFF" />
              </VisualBrush.Visual>
            </VisualBrush>
          </Border.BorderBrush>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid HorizontalAlignment="Center">
              <Ellipse Width="230" Height="230" IsHitTestVisible="False">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#886C4DFF" Offset="0" />
                    <GradientStop Color="#006C4DFF" Offset="1" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Border x:Name="DafiKutu" Width="150" Height="150" CornerRadius="75" Background="Black" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform x:Name="DafiKay" /></Border.RenderTransform>
                <Border.Clip><EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75" /></Border.Clip>
                <Image Source="gorseller/dafi.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.RenderTransform><ScaleTransform ScaleX="1.22" ScaleY="1.22" CenterX="75" CenterY="80" /></Image.RenderTransform>
                </Image>
              </Border>
            </Grid>
            <TextBlock x:Name="BosBaslik" Text="{DynamicResource s.drop_title}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Parlak}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="{DynamicResource s.drop_formats}" Foreground="{StaticResource Soluk}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
              <Button Style="{StaticResource AnaDugme}" Click="Ac_Click" Height="44" Padding="26,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,10,0" />
                  <TextBlock Text="{DynamicResource s.open_archive}" VerticalAlignment="Center" FontSize="14.5" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Dugme}" Click="YeniArsiv_Click" Height="44" Padding="22,0" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,10,0" />
                  <TextBlock Text="{DynamicResource s.new_archive}" VerticalAlignment="Center" FontSize="14.5" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{DynamicResource s.drop_hint}" Foreground="#6F6A94" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="SurukleKatman" Visibility="Collapsed" IsHitTestVisible="False" Background="#996C4DFF" Margin="10">
      <Border CornerRadius="24" BorderBrush="White" BorderThickness="3" Margin="20">
        <TextBlock Text="{DynamicResource s.drop_overlay}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Border>

    <Grid x:Name="IlerlemeKatman" Visibility="Collapsed" Background="#CC07060F">
      <Border Width="480" CornerRadius="22" Background="{StaticResource Kart}" BorderBrush="{StaticResource Cizgi}" BorderThickness="1" Padding="28" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect Color="#6C4DFF" BlurRadius="60" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="IlerlemeBaslik" Text="{DynamicResource s.extracting}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Parlak}" />
          <TextBlock x:Name="IlerlemeDosya" Foreground="{StaticResource Soluk}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          <Grid Margin="0,20,0,0" Height="12">
            <Border CornerRadius="6" Background="#0E0C1C" />
            <Border x:Name="IlerlemeDolgu" CornerRadius="6" HorizontalAlignment="Left" Width="0" Background="{StaticResource VurguGecis}">
              <Border.Effect><DropShadowEffect Color="#A24DFF" BlurRadius="16" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
            </Border>
          </Grid>
          <Grid Margin="0,12,0,0">
            <TextBlock x:Name="IlerlemeYuzde" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Parlak}" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="IlerlemeHiz" Foreground="{StaticResource Vurgu2}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              <TextBlock x:Name="IlerlemeSayac" Foreground="{StaticResource Soluk}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="KlasoruAcDugme" Style="{StaticResource AnaDugme}" Click="KlasoruAc_Click" Visibility="Collapsed" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE838;" FontFamily="{StaticResource Simge}" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{DynamicResource s.open_folder}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="IptalDugme" Style="{StaticResource Dugme}" Content="{DynamicResource s.cancel}" Click="Iptal_Click" MinWidth="90" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="YukleniyorKatman" Visibility="Collapsed" Background="#8807060F">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="54" Height="54">
          <Ellipse Stroke="#2A2450" StrokeThickness="5" />
          <Ellipse x:Name="Donen" Stroke="{StaticResource Vurgu2}" StrokeThickness="5" StrokeDashArray="6 20" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="DonenAci" /></Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
        <TextBlock x:Name="YukleniyorYazi" Text="{DynamicResource s.reading}" Foreground="{StaticResource Yazi}" Margin="0,14,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
