<Project Sdk="Microsoft.NET.Sdk">
  <!-- Motor testleri: arşivleri açar, çıkarır, SHA-256 ile karşılaştırır. Bkz. testler/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Motor\*.cs" Link="Motor\%(Filename)%(Extension)" />
    <None Include="..\..\native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
