<Application x:Class="DafiumArsiv.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Dafium "Gece Moru" paleti -->
    <Color x:Key="ZeminR">#0E0C1C</Color>
    <SolidColorBrush x:Key="Zemin" Color="#0E0C1C" />
    <SolidColorBrush x:Key="Panel" Color="#15122A" />
    <SolidColorBrush x:Key="Kart" Color="#1C1838" />
    <SolidColorBrush x:Key="Hover" Color="#221D42" />
    <SolidColorBrush x:Key="Secili" Color="#2C2463" />
    <SolidColorBrush x:Key="Cizgi" Color="#2A2450" />
    <SolidColorBrush x:Key="Yazi" Color="#E6E2F7" />
    <SolidColorBrush x:Key="Parlak" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Soluk" Color="#9A94BF" />
    <SolidColorBrush x:Key="Vurgu" Color="#6C4DFF" />
    <SolidColorBrush x:Key="Vurgu2" Color="#B7A6FF" />
    <SolidColorBrush x:Key="Yesil" Color="#4BE3B0" />
    <SolidColorBrush x:Key="Kirmizi" Color="#FF5C6C" />
    <LinearGradientBrush x:Key="VurguGecis" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#6C4DFF" Offset="0" />
      <GradientStop Color="#A24DFF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Yazitipi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Simge">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Ana düğme -->
    <Style x:Key="AnaDugme" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource VurguGecis}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="K" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Opacity" Value="0.9" /></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="K" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="K" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- İkincil düğme -->
    <Style x:Key="Dugme" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="K" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="#33FFFFFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="K" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SimgeDugme" TargetType="Button" BasedOn="{StaticResource Dugme}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource Simge}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Seçenek kartı (biçim/seviye seçimi) -->
    <Style x:Key="SecenekKart" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="K" CornerRadius="12" Background="#0E0C1C" BorderBrush="{StaticResource Cizgi}" BorderThickness="1.5" Padding="12,10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="{StaticResource Hover}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="K" Property="BorderBrush" Value="{StaticResource Vurgu}" />
                <Setter TargetName="K" Property="Background" Value="#2C2463" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="K" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Kutu" TargetType="TextBox">
      <Setter Property="Background" Value="#0E0C1C" />
      <Setter Property="Foreground" Value="{StaticResource Parlak}" />
      <Setter Property="CaretBrush" Value="{StaticResource Vurgu2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Üç nokta menüsü -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource Kart}" />
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6">
              <ItemsPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="K" CornerRadius="8" Padding="12,9" Background="Transparent" MinWidth="230">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Simge}" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Vurgu2}" />
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="K" Property="Background" Value="{StaticResource Hover}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pencere düğmeleri (özel başlık çubuğu) -->
    <Style x:Key="PencereDugme" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="FontFamily" Value="{StaticResource Simge}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="K" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="#1FFFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="KapatDugme" TargetType="Button" BasedOn="{StaticResource PencereDugme}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="K" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="#E81123" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Liste satırları -->
    <Style x:Key="Satir" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="K" Background="Transparent" CornerRadius="9" Margin="6,1">
              <GridViewRowPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="{StaticResource Hover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="K" Property="Background" Value="{StaticResource Secili}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SutunBasligi" TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource Soluk}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border Background="Transparent" Padding="12,10,8,10" BorderBrush="{StaticResource Cizgi}" BorderThickness="0,0,0,1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- İnce kaydırma çubuğu -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3370" CornerRadius="4" Margin="1" /></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8" />
          <Setter Property="MinHeight" Value="8" />
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb"><Border Background="#3A3370" CornerRadius="4" Margin="1" /></ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Kart}" />
      <Setter Property="Foreground" Value="{StaticResource Yazi}" />
      <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Application.Resources>
</Application>
